# Скопируйте в .env и заполните значения.
# Секреты не коммитьте.
# Обязательные переменные без значения останавливают сервер с кодом 1.

# Обязательные
PORT=3000
OPENAI_API_KEY=
WA_PHONE=
TG_USER=
SESSION_SECRET=
DATA_DIR=./data

# Необязательные
# Пусто — сайт открывается только на этом компьютере.
# 0.0.0.0 — слушать все интерфейсы (так нужно в Docker).
HOST=127.0.0.1

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Только для reasoning-моделей (gpt-5*, o*): low / medium / high.
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_MS=45000

CHAT_NAME=Асель
DB_FILENAME=dinara.sqlite
# Полный путь к исполняемому файлу Chrome или Chromium. Без него PDF не собирается.
CHROME_PATH=
# true — только внутри Docker, где у Chrome нет песочницы. На своём компьютере оставьте пустым.
CHROME_NO_SANDBOX=
PDF_TIMEOUT_MS=30000
# error | info | debug
LOG_LEVEL=info
# true — показать в админке кнопку сброса каталога на демо-товары
ENABLE_DEMO_RESET=false
# Пароль админки. Пока пусто, вход закрыт.
ADMIN_PASSWORD=

# Защита ключа от перерасхода: лимит сообщений в чат с одного IP
CHAT_LIMIT_PER_MINUTE=12
CHAT_LIMIT_PER_DAY=300
CHAT_GLOBAL_PER_MINUTE=30
CHAT_GLOBAL_PER_DAY=800
CHAT_MAX_INFLIGHT=4

# Защита от спама заказами: сколько заказов можно оформить с одного IP
ORDER_LIMIT_PER_10_MIN=5
ORDER_LIMIT_PER_DAY=20

# HTTPS, если есть сертификат. Без этих двух файлов сайт остаётся на http.
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

# 1 — если сайт открыт наружу через прокси или туннель (ngrok, cloudflared, nginx).
TRUST_PROXY=
